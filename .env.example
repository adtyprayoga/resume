# Nonsecret defaults for compose.yaml (combined deployment with PDF import).
# Copy to .env to change them. Limits may be lowered, not raised: the service
# refuses to start with values above the plan's caps.

# Host port for the website in local runs (compose.override.yaml). Not used
# on Coolify, which routes the domain itself. The PDF service is never published.
WEB_PORT=8080

# PDF service limits.
PDF_IMPORT_MAX_BYTES=10485760
PDF_IMPORT_MAX_PAGES=5
PDF_IMPORT_TIMEOUT_SECONDS=180
PDF_IMPORT_RESULT_TTL_SECONDS=600

# Container resources: memory in bytes (no swap is added) and CPU cores.
PDF_IMPORT_MEMORY_LIMIT_BYTES=2750000000
PDF_IMPORT_CPU_LIMIT=2

# Frontend build flag, set by compose.yaml for the combined image. Leave unset
# for the static-only build; `VITE_PDF_IMPORT=1 bun run dev` enables it locally.
# VITE_PDF_IMPORT=1
