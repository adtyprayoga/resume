    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.6",
    "jsdom": "^30.1.3",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
